<%- include("../partials/head") %>
<%- include("../partials/header") %>

<h2 class="h4 mb-3">Available Jobs</h2>

<% if (!jobs || jobs.length === 0) { %>
  <div class="alert alert-secondary">No jobs yet.</div>
<% } else { %>
  <div class="row g-3">
    <% jobs.forEach((job) => { %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">

            <% const imgSrc = job.imageFile 
            ? `/uploads/${job.imageFile}` 
            : (job.imageUrl || null); %>
    
      <% if (imgSrc) { %>
        <img 
          src="<%= imgSrc %>" 
          class="card-img-top" 
          alt="<%= job.companyName %>"
          style="height: 180px; object-fit: cover;"
        />
          <% } %>

          <div class="card-body">
            <h5 class="card-title mb-1"><%= job.companyName %></h5>
            <p class="card-text mb-2"><%= job.positionTitle %></p>

            <% if (job.detailsUrl) { %>
              <a
                class="btn btn-sm btn-outline-primary"
                href="<%= job.detailsUrl %>"
                target="_blank"
                rel="noopener"
              >
                For more details
              </a>
            <% } %>

            <% if (user && user.role === "admin") { %>
              <div class="mt-3 d-flex gap-2">
                <a class="btn btn-sm btn-outline-dark" href="/jobs/<%= job._id %>/edit">Edit</a>
                <form method="POST" action="/jobs/<%= job._id %>/delete" class="m-0">

                  <input type="hidden" name="_csrf" value="<%= _csrf %>">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
              </div>
            <% } %>
          </div>

        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include("../partials/footer") %>