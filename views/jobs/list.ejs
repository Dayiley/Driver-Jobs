<%- include("../partials/head") %>
<%- include("../partials/header") %>

<div class="container py-4">


<section class="py-5 mb-4 border-bottom">
  <div class="px-4">

    <h2 class="fw-semibold mb-2">
      Welcome <%= user.name %> 👋
    </h2>
    
    <p class="text-muted">
      <% if (user.role === "admin") { %>
        Manage job listings and review driver profiles.
      <% } else { %>
        Browse available jobs and manage your driver profile.
      <% } %>

    <p class="text-muted mb-3" style="max-width: 700px;">
      Driver Jobs helps you explore opportunities in the trucking industry
      and manage your professional profile in one place.
    </p>

  </div>
</section>

<h2 class="h4 mb-3">Available Jobs</h2>

<form method="GET" action="/jobs" class="search-bar-wrap mb-4">
  <div class="search-bar d-flex align-items-center">
    <span class="search-icon me-2">🔎</span>

    <input
      type="text"
      name="q"
      class="form-control border-0 shadow-none me-2"
      placeholder="Search company, position, or hiring area..."
      value="<%= q || '' %>"
    />

    <button class="btn btn-primary px-4 rounded-pill" type="submit">Search</button>
  </div>

  <% if (q) { %>
    <div class="mt-2">
      <a href="/jobs" class="small text-decoration-none">Clear search</a>
    </div>
  <% } %>
</form>

<% if (!jobs || jobs.length === 0) { %>
  <div class="alert alert-secondary">No jobs yet.</div>
<% } else { %>
  <div class="row g-3">
    <% jobs.forEach((job) => { %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100">

            <% const imgSrc = job.imageFile 
            ? `/uploads/${job.imageFile}` 
            : (job.imageUrl || null); %>
    
      <% if (imgSrc) { %>
        <img 
          src="<%= imgSrc %>" 
          class="card-img-top" 
          alt="<%= job.companyName %>"
          style="height: 180px; object-fit: cover;"
        />
          <% } %>

          <div class="card-body">
            <h5 class="card-title mb-1"><%= job.companyName %></h5>
            <p class="card-text mb-2"><%= job.positionTitle %></p>
            <p class="card-text mb-1">
              <strong>Hiring Area:</strong> <%= job.hiringArea %>
            </p>

            <% if (job.detailsUrl) { %>
              <a
                class="btn btn-sm btn-outline-primary"
                href="<%= job.detailsUrl %>"
                target="_blank"
                rel="noopener"
              >
                For more details
              </a>
            <% } %>

            <% if (user && user.role === "admin") { %>
              <div class="mt-3 d-flex gap-2">
                <a class="btn btn-sm btn-outline-dark" href="/jobs/<%= job._id %>/edit">Edit</a>
                <form method="POST" action="/jobs/<%= job._id %>/delete" class="m-0">

                  <input type="hidden" name="_csrf" value="<%= _csrf %>">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                </form>
              </div>
            <% } %>
          </div>

        </div>
      </div>
    <% }) %>
  </div>
<% } %>
</div>
<%- include("../partials/footer") %>