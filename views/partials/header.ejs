<nav class="navbar navbar-expand-lg navbar-light bg-white border shadow-sm px-3 py-2 mb-4">
  <div class="container-fluid px-0">

    <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="/jobs">
      <img src="/img/logo.png" alt="Driver Jobs Logo" style="height: 40px; width: auto;" />
      <span>Driver Jobs</span>
    </a>

    <% if (user) { %>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#mainNavbar"
        aria-controls="mainNavbar"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNavbar">
        <div class="navbar-nav me-auto">
          <% if (user.role === "admin") { %>
            <a class="nav-link" href="/profiles">Profiles</a>
          <% } else { %>
            <a class="nav-link" href="/profiles">My Info</a>
          <% } %>

          <!-- Later:
          <a class="nav-link" href="/news">News</a>
          -->

          <% if (user.role === "admin") { %>
            <a class="nav-link" href="/jobs/new">Add Job</a>
          <% } %>
        </div>

        <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
          <div class="text-muted small">
            Logged in as
            <strong class="text-dark"><%= user.name %></strong>

            <% if (user.role === "admin") { %>
              <span class="badge bg-dark ms-2">Admin</span>
            <% } %>
          </div>

          <form method="POST" action="/sessions/logoff" class="m-0">
            <input type="hidden" name="_csrf" value="<%= _csrf %>">
            <button class="btn btn-outline-danger btn-sm" type="submit">Logoff</button>
          </form>
        </div>
      </div>
    <% } %>

  </div>
</nav>

<% if (errors && errors.length) { errors.forEach((err) => { %>
  <div class="alert alert-danger py-2"><%= err %></div>
<% }) } %>

<% if (info && info.length) { info.forEach((msg) => { %>
  <div class="alert alert-success py-2"><%= msg %></div>
<% }) } %>